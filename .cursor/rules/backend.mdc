## State

```rust
// state.rs
use std::sync::Arc;
use tokio::sync::RwLock;
use aws_sdk_s3::Client;
use crate::storage::connections::ConnectionConfig;
use crate::error::AppError;

#[derive(Default)]
pub struct AppState {
    inner: Arc<RwLock<Option<ActiveSession>>>,
}

struct ActiveSession {
    client: Client,
    bucket: String,
}

impl AppState {
    pub async fn set_session(&self, client: Client, bucket: String) {
        let mut lock = self.inner.write().await;
        *lock = Some(ActiveSession { client, bucket });
    }

    pub async fn client(&self) -> Result<Client, AppError> {
        let lock = self.inner.read().await;
        lock.as_ref()
            .map(|s| s.client.clone())
            .ok_or(AppError::InvalidCredentials)
    }

    pub async fn active_bucket(&self) -> String {
        let lock = self.inner.read().await;
        lock.as_ref().map(|s| s.bucket.clone()).unwrap_or_default()
    }
}
```

