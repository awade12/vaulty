## S3 Client

The client builder handles endpoint resolution per provider. No command or operation should ever construct an `aws_sdk_s3::Client` directly.

```rust
// s3/client.rs
use aws_config::{BehaviorVersion, Region};
use aws_sdk_s3::{Client, Config};
use aws_credential_types::Credentials;
use crate::storage::connections::ConnectionConfig;
use crate::error::AppError;

pub async fn build_client(conn: &ConnectionConfig, secret: &str) -> Result<Client, AppError> {
    let creds = Credentials::new(
        &conn.access_key_id,
        secret,
        None,
        None,
        "s3-drive",
    );

    let config = Config::builder()
        .behavior_version(BehaviorVersion::latest())
        .credentials_provider(creds)
        .endpoint_url(endpoint_for_provider(&conn.provider, &conn.endpoint))
        .region(Region::new(conn.region.clone().unwrap_or_else(|| "auto".into())))
        .force_path_style(conn.provider == "minio")
        .build();

    Ok(Client::from_conf(config))
}

fn endpoint_for_provider(provider: &str, custom_endpoint: &str) -> String {
    match provider {
        "r2" => format!("https://{}", custom_endpoint),
        "minio" => custom_endpoint.to_owned(),
        "s3" => "https://s3.amazonaws.com".to_owned(),
        "b2" => "https://s3.us-west-004.backblazeb2.com".to_owned(),
        _ => custom_endpoint.to_owned(),
    }
}
```

