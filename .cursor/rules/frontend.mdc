## Tauri IPC

All `invoke()` calls are centralized in `src/lib/tauri.ts`. Components never import from `@tauri-apps/api` directly.

```ts
// src/lib/tauri.ts
import { invoke } from "@tauri-apps/api/core";
import { BucketFile, BucketCredentials } from "../types";

export async function listBucketFiles(prefix: string): Promise<BucketFile[]> {
  return invoke("list_files", { prefix });
}

export async function deleteFile(key: string): Promise<void> {
  return invoke("delete_file", { key });
}
```

Wrap tauri calls in React Query hooks inside `src/hooks/`:

```ts
// src/hooks/useBucketContents.ts
import { useQuery } from "@tanstack/react-query";
import { listBucketFiles } from "../lib/tauri";

export function useBucketContents(prefix: string) {
  return useQuery({
    queryKey: ["bucket", prefix],
    queryFn: () => listBucketFiles(prefix),
    staleTime: 30_000,
  });
}
```

