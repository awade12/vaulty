## State Management

- Zustand for persistent/cross-route state (active bucket, credentials, UI preferences)
- React Query for server/async state (file lists, bucket metadata)
- Local `useState` for ephemeral component state (modal open, hover, input values)
- Never store derived data in Zustand — derive it in the component or hook

```ts
// src/store/bucketStore.ts
import { create } from "zustand";
import { persist } from "zustand/middleware";
import { BucketConnection } from "../types";

interface BucketStore {
  connections: BucketConnection[];
  activeConnectionId: string | null;
  addConnection: (conn: BucketConnection) => void;
  setActive: (id: string) => void;
}

export const useBucketStore = create<BucketStore>()(
  persist(
    (set) => ({
      connections: [],
      activeConnectionId: null,
      addConnection: (conn) =>
        set((s) => ({ connections: [...s.connections, conn] })),
      setActive: (id) => set({ activeConnectionId: id }),
    }),
    { name: "bucket-store" }
  )
);
```

