{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vaulty",
  "version": "0.1.1",
  "identifier": "com.vaulty.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "vaulty",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "icons/32x32.png"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/awade12/vaulty/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwRjhFMjNCOUU3QkIxRDAKUldUUXNYdWVPK0w0RUdJRWpuWFJMcDBQcms3cmFiVHVHT3RSQ1M2MkpCV1hlOWFYakgycEsrSGIK"
    }
  }
}
